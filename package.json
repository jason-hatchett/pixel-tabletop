{
  "name": "pixel-tabletop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Digital pixel-art tabletop with exact unit positioning for Warhammer 40k / Age of Sigmar and D&D 5E.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
